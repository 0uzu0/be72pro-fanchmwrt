+		 */
+		{
+			struct nf_conn *ct;
+			enum ip_conntrack_info ctinfo;
+
+			ct = nf_ct_get(skb, &ctinfo);
+			if (ct && ct->fwx_data.action)
+				break;
+		}
+
 		if (fn && !mtk_hnat_accel_type(skb))
 			break;
